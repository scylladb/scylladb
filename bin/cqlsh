#!/bin/bash -e

# Copyright (C) 2023-present ScyllaDB
# SPDX-License-Identifier: LicenseRef-ScyllaDB-Source-Available-1.1

trap 'echo "error $? in $0 line $LINENO"' ERR

top=$(cd "$(dirname "$0")/.." && pwd)
# cqlsh is released on its own (scylladb/scylla-cqlsh), run the one test.py uses,
# from the venv test.py uses (see _ensure_running_under_uv() in test.py)
export UV_PROJECT="$top/test"
python=$(cd "$top" && uv python find)
soabi=$("$python" -c "import sysconfig; print(sysconfig.get_config_var('SOABI'))")
export UV_PROJECT_ENVIRONMENT="$top/build/test-dependencies/$soabi"
exec uv run --quiet --locked cqlsh "$@"

