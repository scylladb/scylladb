#!/bin/bash -xue

trap 'echo "error $? in $0 line $LINENO"' ERR

# The training scripts (exec_cql.py, auth_conns_stress.py) need scylla-driver,
# which the toolchain no longer has. Run under test.py's uv project: `uv run`
# puts that venv's python3 first on PATH, so their `python3` calls get it too.
src="$(dirname "$(dirname "$(realpath "$0")")")"
export UV_PROJECT_ENVIRONMENT="$src/build/pgo-dependencies"
exec uv run --project "$src/test" --locked --quiet python3 -u "$src/pgo/pgo.py" train_full "$@"
