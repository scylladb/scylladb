#!/bin/bash

set -e

if [ "$1" = configure ]; then
    getent passwd scylla || NOUSR=1
    getent group scylla || NOGRP=1

    # this handles both case group is not exist || group already exists
    if [ $NOUSR ]; then
        adduser --system \
                --quiet \
                --home /var/lib/scylla \
                --no-create-home \
                --disabled-password \
                --group scylla
    # only group is not exist, create it and add user to the group
    elif [ $NOGRP ]; then
        addgroup --system scylla
        adduser scylla scylla
    fi
    chown -R scylla:scylla /var/lib/scylla
fi

if [ "$1" = configure ] && [ -n "$2" ]; then
    # upgrade from a version that shipped housekeeping: disable and remove leftovers
    systemctl disable --now scylla-housekeeping-daily.timer scylla-housekeeping-restart.timer 2>/dev/null || true
    rm -f /opt/scylladb/scripts/scylla-housekeeping
    rm -f /etc/default/scylla-housekeeping /etc/scylla.d/housekeeping.cfg
    rm -rf /var/lib/scylla-housekeeping
    rm -rf /etc/systemd/system/scylla-housekeeping-daily.service.d /etc/systemd/system/scylla-housekeeping-restart.service.d
fi

ln -sfT /etc/scylla /var/lib/scylla/conf

/opt/scylladb/scripts/scylla_post_install.sh

#DEBHELPER#
