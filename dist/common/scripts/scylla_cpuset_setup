import os
import sys
import argparse
from scylla_util import is_container, sysconfig_parser, parse_cpuset_conf, cpuset_conf_cpus, setup_spare_cpu_pinning

def cpuset_conf_changed(text, cpuset, smp):
    """True when the cpuset.conf text does not set the --cpuset and --smp
    values of the command line. Each value is a string, or None."""
    conf_cpuset, conf_smp = parse_cpuset_conf(text)
    return conf_cpuset != cpuset or (str(conf_smp) if conf_smp is not None else None) != smp

if __name__ == '__main__':
    if not is_container() and os.getuid() > 0:
        print('Requires root permission.')
        sys.exit(1)
    parser = argparse.ArgumentParser(description='Configure cpuset configuration for Scylla.')
    parser.add_argument('--cpuset',
                        help='CPUs to use (in cpuset(7) format; default: all))')
    parser.add_argument('--smp',
                        help='number of threads (default: one per CPU)')
    args = parser.parse_args()
    if not args.cpuset and not args.smp:
        parser.print_help()
        sys.exit(1)

    # sysconfig_parser creates the file when it is missing.
    cfg = sysconfig_parser('/etc/scylla.d/cpuset.conf')
    with open('/etc/scylla.d/cpuset.conf') as f:
        changed = cpuset_conf_changed(f.read(), args.cpuset, args.smp)
    if changed:
        if os.path.exists('/etc/scylla.d/perftune.yaml'):
            os.remove('/etc/scylla.d/perftune.yaml')

        cfg.set('CPUSET', '{cpuset}{smp}'.format( \
                cpuset='--cpuset {} '.format(args.cpuset) if args.cpuset else '', \
                smp='--smp {} '.format(args.smp) if args.smp else '' \
                ))
        cfg.commit()

    # On cloud images this runs at first boot, after the package install.
    # Read the cpuset back from the file, as scylla_prepare does, so that
    # both pin from the same value.
    try:
        setup_spare_cpu_pinning(cpuset_conf_cpus())
    except Exception as e:
        print(f'Warning: could not pin scylla-helper.slice and systemd-journald: {e}', file=sys.stderr)
