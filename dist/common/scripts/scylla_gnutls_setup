# GnuTLS picks the crypto code it uses for TLS records from the CPU features
# it detects, at library load time. On some CPUs, the code it picks is slower
# than the generic nettle code it falls back to (GnuTLS 3.8's aarch64 AES-GCM
# encrypts one block at a time). GNUTLS_CPUID_OVERRIDE masks the detected
# features. Its bits mean different things on each architecture, so a value is
# never applied without measuring it: this script runs `scylla perf-tls` with
# and without each candidate value for this CPU and writes the winner, if it
# wins by a clear margin, to /etc/scylla.d/gnutls.conf, which
# scylla-server.service loads as an EnvironmentFile.

import argparse
import json
import math
import os
import platform
import subprocess
import sys
import tempfile
from pathlib import Path

VARIABLE = 'GNUTLS_CPUID_OVERRIDE'
MARKER = '# Generated by scylla_gnutls_setup.'

# On aarch64, GNUTLS_CPUID_OVERRIDE replaces the features GnuTLS detects
# instead of masking them, so a bit for a feature the CPU lacks makes GnuTLS
# execute instructions the CPU doesn't have. Bit values from GnuTLS's
# aarch64-common.h, keyed by their /proc/cpuinfo flag. Bit 0 is EMPTY_SET.
AARCH64_EMPTY_SET = 0x1
AARCH64_SHA_BITS = {'sha1': 0x8, 'sha2': 0x10, 'sha512': 0x40}


def aarch64_candidates(cpu_flags):
    """Returns the override that keeps the SHA code for the SHA extensions
    the CPU has and drops AES and PMULL, so AES-GCM comes from nettle.
    That is 0x58 on CPUs with SHA512 (e.g. Neoverse V1) and 0x18 on CPUs
    without it (e.g. Neoverse N1)."""
    bits = sum(bit for flag, bit in AARCH64_SHA_BITS.items() if flag in cpu_flags)
    return [hex(bits or AARCH64_EMPTY_SET)]


def cpu_flags():
    try:
        for line in open('/proc/cpuinfo'):
            key, _, value = line.partition(':')
            if key.strip() in ('Features', 'flags'):
                return set(value.split())
    except OSError:
        pass
    return set()


def default_candidates(machine, flags):
    """GNUTLS_CPUID_OVERRIDE values to try. Their bits mean different things
    per architecture: on x86_64, 0x58 drops AES-NI. 0x1 drops all of GnuTLS's
    own accelerated code."""
    if machine == 'aarch64':
        return aarch64_candidates(flags)
    if machine == 'x86_64':
        return ['0x1']
    return []


def conf_path(etcdir):
    return Path(etcdir) / 'scylla.d' / 'gnutls.conf'


def run_perf_tls(scylla, override, perf_args):
    """Runs `scylla perf-tls` with GNUTLS_CPUID_OVERRIDE set to `override`
    (unset if None) and returns its JSON result, or raises RuntimeError."""
    env = dict(os.environ)
    env.pop(VARIABLE, None)
    if override is not None:
        env[VARIABLE] = override
    with tempfile.TemporaryDirectory() as d:
        result_file = Path(d) / 'result.json'
        cmd = [str(scylla), 'perf-tls', '--json-result', str(result_file)] + perf_args
        p = subprocess.run(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, encoding='utf-8')
        if p.returncode != 0 or not result_file.exists():
            raise RuntimeError(f'{" ".join(cmd)} with {VARIABLE}={override} failed (exit code {p.returncode}):\n{p.stdout}')
        result = json.loads(result_file.read_text())
    if not result.get('verified'):
        raise RuntimeError(f'perf-tls with {VARIABLE}={override} did not verify the data round trip')
    if result.get('cpuid_override') != override:
        raise RuntimeError(f'perf-tls ran with {VARIABLE}={result.get("cpuid_override")}, expected {override}')
    return result


def case_key(r):
    return (r['cipher'], r['op'], r['size'])


def best_of(results):
    """Merges perf-tls results of several runs of one setting into
    {case: best MB/s}."""
    best = {}
    for result in results:
        for r in result['results']:
            k = case_key(r)
            best[k] = max(best.get(k, 0), r['mbps'])
    return best


def compare(baseline, candidate):
    """Returns (geometric mean speedup, worst speedup, {case: speedup}) of
    candidate over baseline, both as returned by best_of()."""
    if not baseline or set(baseline) != set(candidate):
        raise RuntimeError('perf-tls runs measured different cases')
    speedups = {k: candidate[k] / baseline[k] for k in baseline}
    geomean = math.exp(sum(math.log(s) for s in speedups.values()) / len(speedups))
    return geomean, min(speedups.values()), speedups


def choose(baseline, candidates, min_speedup, max_regression):
    """Returns the candidate value with the best geometric mean speedup, if it
    reaches min_speedup and no case slows down by more than max_regression,
    else None. `candidates` maps values to best_of() results; values that
    failed to run are left out of it."""
    best = None
    for value, measured in candidates.items():
        geomean, worst, _ = compare(baseline, measured)
        if geomean >= min_speedup and worst >= 1 - max_regression and (best is None or geomean > best[1]):
            best = (value, geomean)
    return best[0] if best else None


def render_conf(value, cpu):
    return (f'{MARKER} Re-run it after changing the hardware.\n'
            f'# GnuTLS encrypts TLS records faster with this setting on: {cpu}\n'
            f'{VARIABLE}={value}\n')


def is_managed(path):
    """True if `path` is absent or was written by this script."""
    return not path.exists() or path.read_text().startswith(MARKER)


def apply(path, content):
    """Makes `path` hold `content`, or removes it if `content` is None.
    Returns True if anything changed."""
    if content is None:
        if path.exists():
            path.unlink()
            return True
        return False
    if path.exists() and path.read_text() == content:
        return False
    tmp = path.with_name(path.name + '.tmp')
    tmp.write_text(content)
    tmp.chmod(0o644)
    tmp.replace(path)
    return True


def cpu_model():
    try:
        for line in open('/proc/cpuinfo'):
            key, _, value = line.partition(':')
            if key.strip() in ('model name', 'CPU part'):
                return f'{platform.machine()} {key.strip()} {value.strip()}'
    except OSError:
        pass
    return platform.machine()


def format_table(baseline, candidates):
    cases = sorted(baseline)
    lines = [f'{"cipher":<14} {"op":<4} {"size":>6} {"baseline":>10}' + ''.join(f' {v:>10} {"x":>6}' for v in candidates)]
    for k in cases:
        line = f'{k[0]:<14} {k[1]:<4} {k[2]:>6} {baseline[k]:>10.1f}'
        for measured in candidates.values():
            line += f' {measured[k]:>10.1f} {measured[k] / baseline[k]:>6.2f}'
        lines.append(line)
    return '\n'.join(lines)


def main():
    from scylla_util import etcdir_p, scyllabindir_p, is_nonroot

    parser = argparse.ArgumentParser(description='Benchmark TLS record encryption with and without GNUTLS_CPUID_OVERRIDE '
                                     'and configure Scylla with the faster setting.')
    parser.add_argument('--candidates',
                        help=f'comma-separated {VARIABLE} values to try (default on this machine: '
                        f'{",".join(default_candidates(platform.machine(), cpu_flags())) or "none"})')
    parser.add_argument('--min-speedup', type=float, default=1.2,
                        help='geometric mean speedup over all measured cases a value needs to be applied (default: %(default)s)')
    parser.add_argument('--max-regression', type=float, default=0.05,
                        help='largest slowdown of any single case a value may cause and still be applied (default: %(default)s)')
    parser.add_argument('--rounds', type=int, default=2,
                        help='times to run perf-tls per setting, alternating settings; the best of them counts (default: %(default)s)')
    parser.add_argument('--duration', type=float, default=0.2,
                        help='seconds of measurement per round of each case in perf-tls (default: %(default)s)')
    parser.add_argument('--scylla', default=str(scyllabindir_p() / 'scylla'),
                        help='scylla executable (default: %(default)s)')
    parser.add_argument('--force', action='store_true',
                        help=f'overwrite {conf_path("/etc")} even if it was not written by this script')
    parser.add_argument('--dry-run', action='store_true',
                        help='measure and report, but do not change the configuration')
    args = parser.parse_args()

    if not is_nonroot() and os.getuid() > 0 and not args.dry_run:
        print('Requires root permission.')
        sys.exit(1)

    path = conf_path(etcdir_p())
    if not args.force and not is_managed(path):
        print(f'{path} was not written by scylla_gnutls_setup, leaving it alone (use --force to replace it).')
        return

    values = args.candidates.split(',') if args.candidates is not None else default_candidates(platform.machine(), cpu_flags())
    values = [v for v in values if v]
    content = None
    try:
        content = measure_and_choose(args, values)
    except RuntimeError as e:
        print(f'WARNING: {e}\nUsing the GnuTLS defaults.')

    if args.dry_run:
        return
    if apply(path, content):
        print(f'{"Wrote" if content else "Removed"} {path}. Restart scylla-server to apply it.')


def measure_and_choose(args, values):
    """Benchmarks `values` against the GnuTLS defaults and returns the
    content of gnutls.conf for the winner, or None."""
    if not values:
        print(f'No {VARIABLE} values to try on {platform.machine()}, using the GnuTLS defaults.')
        return None
    perf_args = ['--smp', '1', '--memory', '1G', '--overprovisioned',
                 '--duration', str(args.duration), '--handshake-duration', '0']
    runs = {None: []} | {v: [] for v in values}
    failed = set()
    for _ in range(args.rounds):
        for v in runs:
            if v in failed:
                continue
            try:
                runs[v].append(run_perf_tls(args.scylla, v, perf_args))
            except RuntimeError as e:
                if v is None:
                    raise
                print(f'Skipping {VARIABLE}={v}: {e}')
                failed.add(v)
    baseline = best_of(runs[None])
    candidates = {v: best_of(r) for v, r in runs.items() if v is not None and v not in failed}
    print(f'TLS record throughput, MB/s, best of {args.rounds} runs, gnutls {runs[None][0]["gnutls_version"]}:')
    print(format_table(baseline, candidates))
    for v, measured in candidates.items():
        geomean, worst, _ = compare(baseline, measured)
        print(f'{VARIABLE}={v}: {geomean:.2f}x geometric mean, {worst:.2f}x worst case')
    chosen = choose(baseline, candidates, args.min_speedup, args.max_regression)
    if chosen is not None:
        print(f'Using {VARIABLE}={chosen}.')
        return render_conf(chosen, cpu_model())
    print(f'No {VARIABLE} value is at least {args.min_speedup}x faster, using the GnuTLS defaults.')
    return None


if __name__ == '__main__':
    main()
