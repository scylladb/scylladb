import os
import sys
from scylla_util import cpuset_conf_cpus, setup_helper_slice_cpuset

# scylla_post_install.sh runs this on upgrade. scylla_prepare makes the same
# call before every Scylla start.
if __name__ == '__main__':
    if os.getuid() > 0:
        print('Requires root permission.')
        sys.exit(1)
    try:
        setup_helper_slice_cpuset(cpuset_conf_cpus(), always_reload=False)
    except Exception as e:
        print(f'Warning: could not pin scylla-helper.slice: {e}', file=sys.stderr)
        sys.exit(1)
