{
   "apiVersion":"0.0.1",
   "swaggerVersion":"1.2",
   "basePath":"{{Protocol}}://{{Host}}",
   "resourcePath":"/system",
   "produces":[
      "application/json"
   ],
   "apis":[
      {
         "path":"/system/logger",
         "operations":[
            {
               "method":"GET",
               "summary":"Get all logger names",
               "type":"array",
               "items":{
                  "type":"string"
               },
               "nickname":"get_all_logger_names",
               "produces":[
                  "application/json"
               ],
               "parameters":[
               ]
            },
            {
               "method":"POST",
               "summary":"Set all logger level",
               "type":"void",
               "nickname":"set_all_logger_level",
               "produces":[
                  "application/json"
               ],
               "parameters":[
                  {
                     "name":"level",
                     "description":"The new log level",
                     "required":true,
                     "allowMultiple":false,
                     "type":"string",
                     "enum":[
                        "error",
                        "warn",
                        "info",
                        "debug",
                        "trace"
                     ],
                     "paramType":"query"
                  }
               ]
            }
         ]
      },
      {
         "path":"/system/log",
         "operations":[
            {
               "method":"POST",
               "summary":"Write a message to the Scylla log",
               "type":"void",
               "nickname":"write_log_message",
               "produces":[
                  "application/json"
               ],
               "parameters":[
                  {
                     "name":"message",
                     "description":"The message to write to the log",
                     "required":true,
                     "allowMultiple":false,
                     "type":"string",
                     "paramType":"query"
                  },
                  {
                     "name":"level",
                     "description":"The logging level to use",
                     "required":true,
                     "allowMultiple":false,
                     "type":"string",
                     "enum":[
                        "error",
                        "warn",
                        "info",
                        "debug",
                        "trace"
                     ],
                     "paramType":"query"
                  }
               ]
            }
         ]
      },
      {
         "path":"/system/minidump",
         "operations":[
            {
               "method":"POST",
               "summary":"Write a minidump: an ELF core of the running process, readable by gdb, without cache and memtable contents. Each shard stops for well under a millisecond. Returns a JSON report; a failed or aborted dump returns an error carrying the report.",
               "type":"string",
               "nickname":"take_minidump",
               "produces":[
                  "application/json"
               ],
               "parameters":[
                  {
                     "name":"path",
                     "description":"Output file. Defaults to <workdir>/minidumps/scylla-<timestamp>.core",
                     "required":false,
                     "allowMultiple":false,
                     "type":"string",
                     "paramType":"query"
                  },
                  {
                     "name":"include",
                     "description":"Comma-separated selectors of memory to include on top of the defaults, e.g. lsa:memtable:ks.table",
                     "required":false,
                     "allowMultiple":false,
                     "type":"string",
                     "paramType":"query"
                  },
                  {
                     "name":"exclude",
                     "description":"Comma-separated selectors of memory to leave out, e.g. map:*",
                     "required":false,
                     "allowMultiple":false,
                     "type":"string",
                     "paramType":"query"
                  },
                  {
                     "name":"dry_run",
                     "description":"Only classify memory and report what would be dumped",
                     "required":false,
                     "allowMultiple":false,
                     "type":"boolean",
                     "paramType":"query"
                  },
                  {
                     "name":"max_size_ratio",
                     "description":"Refuse dumps bigger than this fraction of the shards' memory (default 0.15)",
                     "required":false,
                     "allowMultiple":false,
                     "type":"number",
                     "paramType":"query"
                  },
                  {
                     "name":"min_free_disk_ratio",
                     "description":"Refuse dumps which would leave less than this fraction of the disk free (default 0.1)",
                     "required":false,
                     "allowMultiple":false,
                     "type":"number",
                     "paramType":"query"
                  },
                  {
                     "name":"max_stall_us",
                     "description":"Abort when a shard's write faults wait longer than this in total, in microseconds (default 30000)",
                     "required":false,
                     "allowMultiple":false,
                     "type":"long",
                     "paramType":"query"
                  },
                  {
                     "name":"helper_cpus",
                     "description":"CPUs for the dumper's threads, e.g. 26-31 (default: CPUs without shards)",
                     "required":false,
                     "allowMultiple":false,
                     "type":"string",
                     "paramType":"query"
                  },
                  {
                     "name":"write_rate_mb",
                     "description":"Write rate limit in MB/s (default: unlimited)",
                     "required":false,
                     "allowMultiple":false,
                     "type":"long",
                     "paramType":"query"
                  }
               ]
            }
         ]
      },
      {
         "path":"/system/drop_sstable_caches",
         "operations":[
            {
               "method":"POST",
               "summary":"Drop in-memory caches for data which is in sstables",
               "type":"void",
               "nickname":"drop_sstable_caches",
               "produces":[
                  "application/json"
               ],
               "parameters":[
               ]
            }
         ]
      },
      {
         "path":"/system/uptime_ms",
         "operations":[
            {
               "method":"GET",
               "summary":"Get system uptime, in milliseconds",
               "type":"long",
               "nickname":"get_system_uptime",
               "produces":[
                  "application/json"
               ],
               "parameters":[]
            }
         ]
      },
      {
         "path":"/system/logger/{name}",
         "operations":[
            {
               "method":"GET",
               "summary":"Get logger level",
               "type":"string",
               "nickname":"get_logger_level",
               "produces":[
                  "application/json"
               ],
               "parameters":[
                  {
                     "name":"name",
                     "description":"The logger to query about",
                     "required":true,
                     "allowMultiple":false,
                     "type":"string",
                     "paramType":"path"
                  }
               ]
            },
            {
               "method":"POST",
               "summary":"Set logger level",
               "type":"void",
               "nickname":"set_logger_level",
               "produces":[
                  "application/json"
               ],
               "parameters":[
                  {
                     "name":"name",
                     "description":"The logger to query about",
                     "required":true,
                     "allowMultiple":false,
                     "type":"string",
                     "paramType":"path"
                  },
                  {
                     "name":"level",
                     "description":"The new log level",
                     "required":true,
                     "allowMultiple":false,
                     "type":"string",
                     "enum":[
                        "error",
                        "warn",
                        "info",
                        "debug",
                        "trace"
                     ],
                     "paramType":"query"
                  }
               ]
            }
         ]
      },
      {
         "path":"/system/dump_llvm_profile",
         "operations":[
            {
               "method":"POST",
               "summary":"Dump llvm profile data (raw profile data) that can later be used for coverage reporting or PGO (no-op if the current binary is not instrumented)",
               "type":"void",
               "nickname":"dump_profile",
               "produces":[
                  "application/json"
               ],
               "parameters":[]
            }
         ]
      },
      {
         "path":"/system/highest_supported_sstable_version",
         "operations":[
            {
               "method":"GET",
               "summary":"Get highest supported sstable version",
               "type":"string",
               "nickname":"get_highest_supported_sstable_version",
               "produces":[
                  "application/json"
               ],
               "parameters":[]
            }
         ]
      },
      {
         "path":"/system/chosen_sstable_version",
         "operations":[
            {
               "method":"GET",
               "summary":"Get sstable version currently chosen for use in new sstables",
               "type":"string",
               "nickname":"get_chosen_sstable_version",
               "produces":[
                  "application/json"
               ],
               "parameters":[]
            }
         ]
      },
      {
         "path":"/system/shard_to_numa_node_mapping",
         "operations":[
            {
               "method":"GET",
               "summary":"Get the shard-to-NUMA-node mapping. The nth element is the NUMA node ID of the nth shard.",
               "type":"array",
               "items":{
                  "type":"long"
               },
               "nickname":"get_shard_to_numa_node_mapping",
               "produces":[
                  "application/json"
               ],
               "parameters":[]
            }
         ]
      }
   ]
}
