            "tags":["client_routes"],
            "produces":[
                "application/json"
            ],
            "parameters":[],
            "responses":{
                "200":{
                    "schema":{
                        "type":"array",
                        "items":{ "$ref":"#/definitions/client_routes_entry" }
                    }
                },
                "default":{
                    "description":"unexpected error",
                    "schema":{"$ref":"#/definitions/ErrorModel"}
                }
            }
        },
        "post": {
            "description":"Create or replace one or more client route entries. Each entry must provide an address and at least one port between 1 and 65535. An entry with an existing (connection_id, host_id) key replaces its address and port values. Changes made through any node are stored cluster-wide and notify drivers subscribed to CLIENT_ROUTES_CHANGE.",
            "operationId":"set_client_routes",
            "tags":["client_routes"],
            "parameters":[
                {
                    "name":"body",
                    "in":"body",
