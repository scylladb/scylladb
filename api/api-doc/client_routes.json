                }
            }
        },
        "delete": {
            "description":"Delete the client route entries identified by the supplied (connection_id, host_id) pairs. Changes made through any node are stored cluster-wide and notify drivers subscribed to CLIENT_ROUTES_CHANGE.",
            "operationId":"delete_client_routes",
            "tags":["client_routes"],
            "parameters":[
                {
                    "name":"body",
