#!/usr/bin/env bpftrace
/*
 * Copyright (C) 2026-present ScyllaDB
 * SPDX-License-Identifier: LicenseRef-ScyllaDB-Source-Available-1.1
 */
/*
 * scylla-stalls: count reactor stall reports per shard thread and collect
 * the user stack that was executing when each stall was detected. Fires
 * on the same events as the "Reactor stalled for N ms" log line, so the
 * rate is bounded by --blocked-reactor-reports-per-minute. The hook is
 * the last call of the report (maybe_report_kernel_trace): generate_trace
 * itself is inlined in release builds.
 *
 * This attaches a uprobe to Seastar's stall detector rather than a scylla
 * USDT probe, so the first argument is the file that holds the Seastar
 * code: the scylla binary for release builds, libseastar.so for dev
 * builds. When scylla runs in a container, prefix the path with
 * /proc/<pid>/root.
 *
 * Usage:
 *     bpftrace tools/bpftrace/scylla-stalls.bt -p $(pgrep -x scylla) /usr/bin/scylla
 *
 * User stacks are only complete when scylla was built with
 * -fno-omit-frame-pointer.
 */

BEGIN
{
    printf("Watching reactor stall reports in %s... Hit Ctrl-C to end.\n", str($1));
}

uprobe:$1:*cpu_stall_detector*maybe_report_kernel_trace*
{
    printf("%s stall reported on %s\n", strftime("%H:%M:%S", nsecs), comm);
    @stalls[comm] = count();
    @stacks[comm, ustack(12)] = count();
}
